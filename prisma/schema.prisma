generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  MEMBER
  CHAIRMAN
  SOVAPOTI
  SOHOSOVAPOTI
  SADHARONSOMPADOK
  SOHOSADHARONSOMPADOK
  SANGOTONIKSOMPADOK
  SOHOSANGOTONIKSOMPADOK
  ARTHOSOMPADOK
  PROCHARSOMPADOK
  DOPTORSOMPADOK
  SANGSKRITIKSOMPADOK
  MOHILASOMPADOK
  AINBISHOYOKSOMPADOK
  CHATROOJUBOSOMPADOK
  KARJONIRBAHISODOSSHO
}

enum Status {
  ACTIVE
  INACTIVE
}

enum WaterBodyType {
  RIVER
  HAOR
}

enum NewsType {
  NEWS
  ACTIVITY
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  phone       String       @unique
  password    String
  role        Role         @default(USER)
  designation Designation?
  imageUrl    String?
  startDate   DateTime?
  endDate     DateTime?
  biography   String?      @db.Text

  status              Status               @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  news                News[]
  createdPublications Publication[] @relation("PublicationCreatedBy")

  @@index([role, status])
}

enum Designation {
  MEMBER
  CHAIRMAN
  SOVAPOTI
  SOHOSOVAPOTI
  SADHARONSOMPADOK
  SOHOSADHARONSOMPADOK
  SANGOTONIKSOMPADOK
  SOHOSANGOTONIKSOMPADOK
  ARTHOSOMPADOK
  PROCHARSOMPADOK
  DOPTORSOMPADOK
  SANGSKRITIKSOMPADOK
  MOHILASOMPADOK
  AINBISHOYOKSOMPADOK
  CHATROOJUBOSOMPADOK
  KARJONIRBAHISODOSSHO
  UPODESTAPORISHOD
}

model WebsiteContent {
  id        String    @id @default(cuid())
  imageUrl  String?
  heading   String
  text      String    @db.Text
  startDate DateTime?
  endDate   DateTime?
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, startDate, endDate])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model News {
  id          String        @id @default(cuid())
  userId      String
  mediaUrl    String?
  mediaType   MediaType?
  heading     String
  details     String        @db.Text
  riverOrHaor WaterBodyType
  type        NewsType
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId])
  @@index([type, createdAt])
}

enum MediaType {
  IMAGE
  VIDEO
}

model ContactMessage {
  id        String   @id @default(cuid())
  reason    String
  name      String
  phone     String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([reason, createdAt])
}

model Constitution {
  id String @id @default(cuid())

  // Bilingual document information
  titleBn       String  @default("গঠনতন্ত্র")
  titleEn       String  @default("Constitution")
  descriptionBn String? @db.Text
  descriptionEn String? @db.Text

  // Bilingual PDF documents
  pdfUrlBn String?
  pdfUrlEn String?

  // Publication and update dates
  publishedAt   DateTime @default(now())
  lastUpdatedAt DateTime @updatedAt

  // Admin and publication status
  uploadedById String?
  status       Status  @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([updatedAt])
}

model Demand {
  id            String  @id @default(cuid())
  titleBn       String  @default("দাবিসমূহ")
  titleEn       String  @default("Our Demands")
  descriptionBn String? @db.Text
  descriptionEn String? @db.Text

  // Publication date and automatic update timestamp
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  status      Status        @default(ACTIVE)
  createdById String?
  points      DemandPoint[]

  createdAt DateTime @default(now())

  @@index([status, publishedAt])
  @@index([updatedAt])
}

model DemandPoint {
  id       String @id @default(cuid())
  demandId String

  pointNumber Int

  headingBn     String
  headingEn     String
  descriptionBn String @db.Text
  descriptionEn String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demand Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  @@unique([demandId, pointNumber])
  @@index([demandId, pointNumber])
}

model DonationAccount {
  id            String   @id @default(cuid())
  accountName   String
  providerName  String
  accountNumber String
  bankAddress   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([providerName])
  @@index([createdAt])
}

enum DonationPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REVIEW
}

model Donation {
  id                 String                @id @default(cuid())
  tranId             String                @unique
  donorName          String
  donorEmail         String
  donorPhone         String
  amount             Decimal               @db.Decimal(10, 2)
  currency           String                @default("BDT")
  message            String?               @db.Text
  status             DonationPaymentStatus @default(PENDING)
  valId              String?               @unique
  bankTranId         String?
  cardType           String?
  riskLevel          Int?
  validationResponse Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  paidAt             DateTime?

  @@index([status, createdAt])
  @@index([donorEmail])
  @@index([bankTranId])
}

enum PublicationType {
  RESEARCH
  PUBLICATION
}

model Publication {
  id       String          @id @default(cuid())
  title    String
  subtitle String?
  type     PublicationType @default(PUBLICATION)
  excerpt  String?         @db.Text
  content  String          @db.Text

  coverImageUrl String?
  documentUrl   String?
  documentName  String?

  authorName        String
  authorDesignation String?
  authorImageUrl    String?
  authorBio         String? @db.Text

  publishedAt DateTime @default(now())
  status      Status   @default(ACTIVE)

  createdById String?
  createdBy   User?   @relation("PublicationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([type, publishedAt])
  @@index([createdById])
}
